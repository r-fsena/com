# Vanguard CRM — Template de Variáveis de Ambiente

# Banco de Dados PostgreSQL / Aurora Serverless v2
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vanguard_crm"

# Autenticação Amazon Cognito
NEXT_PUBLIC_COGNITO_USER_POOL_ID="sa-east-1_example"
NEXT_PUBLIC_COGNITO_CLIENT_ID="exampleclientid123"
NEXT_PUBLIC_COGNITO_REGION="sa-east-1"

# Z-API (WhatsApp Gateway)
ZAPI_BASE_URL="https://api.z-api.io/instances"
ZAPI_WEBHOOK_SECRET=""

# Amazon Bedrock (IA Copiloto)
AWS_BEDROCK_REGION="us-east-1"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

# Amazon S3 (Armazenamento de Anexos)
AWS_S3_BUCKET_NAME="vanguard-crm-attachments"
AWS_S3_REGION="sa-east-1"

# Google Gemini (Motor Nativo de IA do CRM - Custo Mínimo)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GOOGLE_GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"


# Segurança (obrigatório em produção; gere com: openssl rand -hex 32)
SESSION_SECRET=""
NEXT_PUBLIC_APP_URL="https://crm.faithhubs.com"

# Conexão única de desenvolvimento, explicitamente vinculada ao tenant
ZAPI_TENANT_ID=""
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# Asaas: sandbox ou production; em produção a chave é específica de cada tenant no banco
ASAAS_ENVIRONMENT="sandbox"
ASAAS_TENANT_ID=""
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Agendador de automações: gere segredo próprio (mínimo 32 caracteres), diferente da sessão.
AUTOMATIONS_CRON_SECRET=""
# Habilite somente depois de validar o agendador e uma conexão WhatsApp operacional.
AUTOMATIONS_OUTBOUND_ENABLED="false"

# Campanhas: aplique db:migrate:campaigns antes de habilitar o processamento.
CAMPAIGNS_ENABLED="false"
CAMPAIGNS_OUTBOUND_ENABLED="false"

# Fila de qualificação (somente leitura/análise; pode usar o segredo operacional das automações)
QUALIFICATION_CRON_SECRET=""
