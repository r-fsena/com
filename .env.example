# Vanguard CRM — Template de Variáveis de Ambiente

# Banco de Dados PostgreSQL / Aurora Serverless v2
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vanguard_crm"

# Autenticação Amazon Cognito
NEXT_PUBLIC_COGNITO_USER_POOL_ID="sa-east-1_example"
NEXT_PUBLIC_COGNITO_CLIENT_ID="exampleclientid123"
NEXT_PUBLIC_COGNITO_REGION="sa-east-1"

# Z-API (WhatsApp Gateway)
ZAPI_BASE_URL="https://api.z-api.io/instances"
ZAPI_WEBHOOK_SECRET="vanguard-secret-token-123"

# Amazon Bedrock (IA Copiloto)
AWS_BEDROCK_REGION="us-east-1"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

# Amazon S3 (Armazenamento de Anexos)
AWS_S3_BUCKET_NAME="vanguard-crm-attachments"
AWS_S3_REGION="sa-east-1"
