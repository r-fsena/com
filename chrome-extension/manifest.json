{
  "manifest_version": 3,
  "name": "Brokiva — CRM Imobiliário & WhatsApp Sync",
  "version": "1.0.33",
  "description": "Extensão oficial Brokiva: Sincronização de histórico completo, gestão de leads e Copiloto de IA para corretores no WhatsApp Web.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.whatsapp.net/*",
    "https://*.facebook.com/*",
    "https://crm.faithhubs.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://crm.faithhubs.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brokiva CRM Sync",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "icons/icon128.png",
        "icons/brokiva-logo-white.png",
        "icons/brokiva-logo-dark.png"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
