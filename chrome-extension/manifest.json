{
  "manifest_version": 3,
  "name": "Brokiva — CRM Imobiliário & WhatsApp Sync",
  "version": "1.0.1",
  "description": "Extensão oficial Brokiva: Sincronização de histórico completo, gestão de leads e Copiloto de IA para corretores no WhatsApp Web.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://crm.faithhubs.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://crm.faithhubs.com/*", "http://localhost:3000/*"],
      "js": ["crm-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brokiva CRM Sync"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "content.css"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
